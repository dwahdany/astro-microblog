---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { DecisionOutcome, MoveKind } from '../../lib/portfolio/types';
import { formatShortDate } from '../../lib/content';
import MoveBadge from './MoveBadge.astro';
import TagList from '../content/TagList.astro';

interface Props {
  entry: CollectionEntry<'portfolio'>;
  move: MoveKind;
  isDoubleDown: boolean;
  href: string;
  outcome?: DecisionOutcome;
}

const { entry, move, isDoubleDown, href, outcome } = Astro.props;
const { Content } = await render(entry);

// One character in a fixed-width gutter, so the whole log aligns into a column
// the eye can run down. Direction is the only thing worth encoding here — the
// exact kind is spelled out in words a few millimetres away, and a set of
// distinct geometric glyphs would just be a legend the reader has to learn.
const SIGILS: Record<MoveKind, string> = {
  open: '+',
  add: '+',
  trim: '−',
  exit: '×',
  rebalance: '~',
  note: '·',
};
const sigil = SIGILS[move] ?? SIGILS.note;

// Whole percents unless a half-point is genuinely there.
const fmtW = (w: number) => {
  const v = w * 100;
  return `${Math.abs(v - Math.round(v)) < 0.05 ? Math.round(v) : v.toFixed(1)}`;
};
interface LegLine {
  ticker: string;
  change: string;
}

// The log says what changed; it does not score it. A single "since" return per
// leg meant the opposite thing on an exit (what was left on the table) as on an
// open, in the same unlabelled column. That belongs on the decision page under
// "How this has aged", where there is room to say which it is.

// `outcome` carries the pre-trade weight, which the frontmatter cannot: a leg
// only records what the weight BECAME. With it we can print "11.5 → 17.5%";
// without it we print what the entry itself declared.
const legs: LegLine[] = outcome
  ? outcome.legs.map((l) => ({
      ticker: l.ticker,
      change: `${fmtW(l.weightBefore)} → ${fmtW(l.weightAfter)}%`,
    }))
  : entry.data.legs.map((l) => ({
      ticker: l.ticker,
      change:
        l.weight !== undefined
          ? `→ ${fmtW(l.weight)}%`
          : l.portion !== undefined
            ? `−${fmtW(l.portion)}% of it`
            : l.scale !== undefined
              ? `×${l.scale}`
              : 'out',
    }));

const created = entry.data.created;
---

<article id={`pf-${entry.data.slug}`} class="group scroll-mt-8 flex gap-3">
  <span
    class="shrink-0 w-3 select-none text-terminal-border group-hover:text-terminal-muted transition-colors"
    aria-hidden="true">{sigil}</span>

  <div class="flex-1 min-w-0">
    <div class="flex flex-wrap items-baseline gap-x-3 text-[11px] text-terminal-muted">
      <time datetime={created.toISOString()}>{formatShortDate(created)}</time>
      <MoveBadge kind={move} isDoubleDown={isDoubleDown} />
    </div>

    <h3 class="text-base font-medium mt-1">
      <a href={href} class="text-terminal-text hover:text-terminal-accent-cyan transition-colors">
        {entry.data.title}
      </a>
    </h3>

    {legs.length > 0 && (
      <ul class="mt-1.5 flex flex-wrap gap-x-5 gap-y-0.5 text-xs text-terminal-muted">
        {legs.map((leg) => (
          <li class="whitespace-nowrap">
            <span class="text-terminal-text">{leg.ticker}</span>
            {' '}{leg.change}
          </li>
        ))}
      </ul>
    )}

    {/*
      Rendered in full, like NoteCard and BlogmarkCard. EntryCard clamps
      because those are long articles standing in for themselves; here the
      reasoning IS the entry, and a decision note truncated mid-thesis is
      worse than a longer page.
    */}
    <div class="mt-1.5 text-terminal-text text-sm prose prose-sm max-w-none">
      <Content />
    </div>

    {entry.data.tags.length > 0 && (
      <div class="mt-1.5 text-xs text-terminal-muted">
        <TagList tags={entry.data.tags} />
      </div>
    )}
  </div>
</article>
